+    // Tenday patch: Material's BottomSheetBehavior only lets inner content scroll before
+    // dragging the sheet when it found that scroll view during its own layout pass. With Fabric
+    // the content ScrollView usually mounts after that pass, so every downward drag dismissed the
+    // sheet. Re-lay out the sheet whenever a new nested-scrolling descendant appears.
+    private var sheetScrollingChild: java.lang.ref.WeakReference<View>? = null
+    private val sheetScrollingChildObserver =
+        android.view.ViewTreeObserver.OnGlobalLayoutListener {
+            if (!usesFormSheetPresentation()) return@OnGlobalLayoutListener
+            val found = findSheetScrollingChild(this)
+            if (found != null && found !== sheetScrollingChild?.get()) {
+                sheetScrollingChild = java.lang.ref.WeakReference(found)
+                (parent as? View)?.requestLayout()
+            }
+        }
+
+    private fun findSheetScrollingChild(view: View): View? {
+        if (view.visibility != View.VISIBLE) return null
+        if (androidx.core.view.ViewCompat.isNestedScrollingEnabled(view)) return view
+        if (view is ViewGroup) {
+            for (i in 0 until view.childCount) {
+                findSheetScrollingChild(view.getChildAt(i))?.let { return it }
+            }
+        }
+        return null
+    }
+
